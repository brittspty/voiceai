# Copy to .env. Never commit .env.

# App
APP_URL=http://127.0.0.1:43123
SESSION_SECRET=replace-with-a-long-random-string
INTEGRATIONS_MODE=mock
WORKER_STEP_MS=1600

# Local docker-compose publishes Postgres on 54329 and Redis on 63799.
DATABASE_URL=postgresql://voiceops:voiceops@127.0.0.1:54329/voiceops
REDIS_URL=redis://127.0.0.1:63799

# GoHighLevel
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_WEBHOOK_SECRET=

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_SECRET=

# Workspace identity. Applied only on the first seed. Defaults are Specificity Inc / Avery.
# SEED_OFFICES format: Name|office|Timezone;Name|virtual
SEED_ORG_NAME=
SEED_ORG_SUBTITLE=
SEED_AGENT_NAME=
SEED_TIMEZONE=
SEED_OFFICES=
SEED_BRAND_COLOR=
SEED_LOGO_URL=
SEED_MARK=
SEED_KNOWLEDGE_TITLE=
SEED_KNOWLEDGE_PATH=
SEED_SAMPLE_DATA=
SHOW_DEMO_LOGIN=

# Operators created on the first seed. Defaults live in the README.
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_VIEWER_NAME=
SEED_VIEWER_EMAIL=
SEED_VIEWER_PASSWORD=
