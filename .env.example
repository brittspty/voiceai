# Copy to .env. Never commit .env.

# App
APP_URL=http://127.0.0.1:43123
# Public Jarvis homepage at /. Off by default. Leave this off and / stays the signed-in app.
PUBLIC_HOMEPAGE=off
# Homepage layout while PUBLIC_HOMEPAGE is on. B is the default. Set A for the other direction.
# HOMEPAGE_DIRECTION=B
# Prospect demo. Off unless DEMO_WORKSPACE is on AND DEMO_ACCESS_SECRET is set.
# Do not put a password in source. The secret is the demo login and the link signer.
DEMO_WORKSPACE=off
DEMO_TOUR=off
DEMO_ACCESS_SECRET=
# Client plans. Off unless set to on. Links expire after CLIENT_PLAN_LINK_DAYS (default 30).
CLIENT_PLANS=off
CLIENT_PLAN_LINK_DAYS=30
SESSION_SECRET=replace-with-a-long-random-string
INTEGRATIONS_MODE=mock
WORKER_STEP_MS=1600

# AIS2L calling compliance. Defaults off. Does not turn voice live; leave INTEGRATIONS_MODE=mock until a pilot.
# on: opt-out to do-not-call, replace GoHighLevel outcome tags, one 20s voicemail, 9 AM–8 PM local time, opener, human handoff.
AIS2L_COMPLIANCE_V2=off
# Hang up after this many seconds of silence while the flag is on. Values are clamped to 10–15. Default 12.
AIS2L_SILENCE_HANGUP_SEC=12
# Reason said at the start of the call while the flag is on.
AIS2L_CALL_REASON=you asked for a short introduction

# Local docker-compose publishes Postgres on 54329 and Redis on 63799.
DATABASE_URL=postgresql://voiceops:voiceops@127.0.0.1:54329/voiceops
REDIS_URL=redis://127.0.0.1:63799

# GoHighLevel
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_WEBHOOK_SECRET=

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_SECRET=

# Meta Marketing API (system user token). Leave blank to skip sync.
# Scopes on the token: ads_read, and read_insights when granted.
# META_APP_SECRET: when set, every Graph call sends appsecret_proof
# (HMAC-SHA256 of META_ACCESS_TOKEN keyed by this secret). Never store the token or secret in the database.
# META_APP_ID example: 1093413013101625
# META_AD_ACCOUNT_IDS is a comma-separated list for THIS deployment. One deployment
# can sync several accounts. There is no built-in account id.
# Example account: act_532471207924121 (Specificity Inc Marketing, USD, America/New_York)
# Validate outside the app with:
#   npm run meta:sync -- --account act_532471207924121 --days 30 --dry-run
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_IDS=
META_GRAPH_VERSION=v23.0
META_ATTRIBUTION_WINDOWS=7d_click,1d_view
# auto (default): live when token, app id, app secret, and at least one account are available; otherwise skip.
# mock loads labeled fixtures. off never syncs. live requires the credentials above.
MARKETING_SYNC_MODE=
# Trailing days re-pulled each run (1-90). Windows longer than 7 days use an async insights job.
MARKETING_LOOKBACK_DAYS=7
# Worker interval. Empty uses the default: 6 hours, or 15 minutes when MARKETING_INTRADAY_SYNC=on.
MARKETING_SYNC_INTERVAL_MS=
# Risky marketing jobs. All default off. Do not turn these on until the deploy checklist is approved.
MARKETING_INTRADAY_SYNC=off
MARKETING_MONITOR=off
# Creative fatigue flags and draft variations. Off until a person turns it on. Nothing auto-publishes.
MARKETING_CREATIVE_FATIGUE=off
# Budget pacing recommendations. Off until a person turns it on. Never writes a budget.
MARKETING_PACING_RECS=off
MARKETING_DIGEST=off
MARKETING_DIGEST_DELIVERY=off
# Hourly account-manager email and inbox. Off until a person turns it on.
# Needs MARKETING_DIGEST=on as well. Test mode writes the mail log and does not call Resend.
MARKETING_DIGEST_SEND=off
# Live notes, anomaly flags, and fatigue yes/no for each account manager's own campaigns.
# Super admins see every campaign. Off until a person turns it on.
AM_REALTIME_FEED=off
# Offer a new skill's yes/no to every super admin, with an audit log. Off until a person turns it on.
MARKETING_SKILL_APPROVAL=off
# Super-admin page for assigning roles. Off until a person turns it on. It does not create users.
MARKETING_ROLE_ADMIN=off
# Opt-in so an all-clients viewer can see spend. Off by default. Only super admins and account managers see cost otherwise.
ALL_CLIENTS_VIEWER_SEES_COST=off
MARKETING_CLIENT_LINKS=off
# Inviting a client viewer (email login). Off until an owner turns it on. Passwords must be 12+ characters.
MARKETING_CLIENT_VIEWERS=off
# Speed-to-lead. Off by default. Measures seconds from page landing (or form submit / call start) to the first person or voice response. Does not place calls or change ads.
MARKETING_SPEED_TO_LEAD=off
# HMAC for POST /api/webhooks/landing. Unsigned requests are rejected while the flag is on.
# Sign hex(HMAC-SHA256(secret, workspaceId + "." + rawBody)) and send it in x-voiceops-signature.
# Send the workspace id in x-voiceops-workspace. This deployment's id is org.
# Per workspace: {"org":"long-random-secret"}. The single secret below is used for org when the map does not set it.
SPEED_TO_LEAD_WEBHOOK_SECRET=
SPEED_TO_LEAD_WEBHOOK_SECRETS=
# Lead quality labels for form leads and call transcripts. Off leaves scoring, tiles, and marks unused.
# With no LEAD_SCORING_API_KEY the scorer stays on the built-in rules.
MARKETING_LEAD_SCORING=off
LEAD_SCORING_API_KEY=
# Optional OpenAI-compatible chat completions URL and model name.
LEAD_SCORING_API_URL=
LEAD_SCORING_MODEL=
# Offline conversion feedback. Both default off. Dry run logs payloads and sends nothing.
# Live send also needs a per-client yes card, plus that client's Meta dataset id and Google Ads customer id.
# Those ids are saved on the client. GOOGLE_ADS_CUSTOMER_IDS below is the read connector's allow-list, not the upload destination.
# Upload code can only post conversion events. It cannot change campaigns, budgets, ads, or keywords.
MARKETING_OFFLINE_CONVERSIONS=off
MARKETING_OFFLINE_CONVERSIONS_LIVE=off
# Meta Conversions API token. It can send to the datasets saved on each client. ads_read is not enough.
META_CAPI_ACCESS_TOKEN=
# Landing page uptime, speed, form, and pixel checks. Off until the owner turns it on.
MARKETING_PAGE_MONITOR=off
# Pause ads after 3 failed checks about a minute apart, and only for a client who opted in on Sites.
# Off by default. A pause is logged until that client has a saved write credential.
MARKETING_PAGE_AUTOPAUSE=off
# This worker must reach the canary before a page failure can pause ads. Not a second region.
PAGE_MONITOR_CANARY_URL=https://www.gstatic.com/generate_204
# Optional write tokens, separate from META_ACCESS_TOKEN (ads_read). Never put the token in the database.
# Each client needs its own saved credential row. Meta scope: ads_management.
# Google pause/resume calls only adGroupAds:mutate, and only for a customer id in GOOGLE_ADS_CUSTOMER_IDS.
# Do not set GOOGLE_ADS_CUSTOMER_ID. The name is plural. API default is v26.
META_PAGE_WRITE_TOKEN=
META_PAGE_WRITE_APP_SECRET=
GOOGLE_ADS_WRITE_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Search-term waste. Reads Google search terms already stored by the Google Ads connector and can import a report into that same table. Exports a negative-keyword CSV. Never writes to an ad account.
MARKETING_SEARCH_WASTE=off
# Competitor ads from the public Meta Ad Library only. No Google Ads Transparency scrape.
MARKETING_COMPETITOR_WATCH=off
# Holdout design, assignment, and lift readout. Does not change ads or budgets.
MARKETING_HOLDOUTS=off
# Bayesian ad fatigue. Off until a person turns it on. Keep, rotate, or pause recommendations only.
# Confidence starts at 0.8. Per-client overrides: {"client:ID":0.9}
# Platforms default to meta. Add google_ads to score stored Google rows with the same model.
# Yes records the account manager's answer. Ads and budgets are not changed.
MARKETING_AD_FATIGUE=off
MARKETING_AD_FATIGUE_CONFIDENCE=0.8
MARKETING_AD_FATIGUE_THRESHOLDS=
MARKETING_AD_FATIGUE_PLATFORMS=meta
# StackAdapt read-only GraphQL. Off until a person turns it on. Needs STACKADAPT_API_KEY.
# Campaigns, line items, creatives, and daily delivery map into the shared metric tables.
# The client refuses mutations. Budgets are not written.
MARKETING_STACKADAPT=off
STACKADAPT_API_KEY=
# Google Business Profile reads. Off until a person turns it on.
# Reuses GOOGLE_ADS_CLIENT_ID, GOOGLE_ADS_CLIENT_SECRET, and GOOGLE_ADS_REFRESH_TOKEN.
# The refresh token needs the Business Profile scope. This connector only sends GET.
# Location ids are numeric, comma-separated. The account id is used to read reviews.
MARKETING_GBP=off
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_IDS=
# Countries sent to the Meta Ad Library. Default US.
META_AD_LIBRARY_COUNTRIES=US
# Staff, client, and share dashboards plus onboarding lead value. Off until approved.
MARKETING_DASHBOARDS_V2=off
# Command center, decisions, channel drill, and the live-notes shell. Off leaves the current UI.
JARVIS_UI_V2=off
# Reports v2: dark staff and client reports, light PDF, share links. Off until approved.
JARVIS_REPORTS_V2=off
# Account managers need a super admin to approve a recommended budget above this amount.
MARKETING_AM_BUDGET_CAP_USD=500
# JSON map of vertical -> {ctr,cpc,cpm,cpa,cpl}. Example: {"leads":{"ctr":0.01,"cpa":25}}
MARKETING_BENCHMARKS=
MARKETING_BASELINE_DAYS=7
MARKETING_ALERT_MIN_IMPRESSIONS=200
MARKETING_MIN_IMPRESSIONS=1000
MARKETING_MIN_CLICKS=20
# Google Ads. One block for every Google feature. Off unless MARKETING_GOOGLE_ADS=on.
# Leave the secrets blank to skip. Do not add GOOGLE_ADS_CUSTOMER_ID; the name is plural.
# GOOGLE_ADS_CUSTOMER_IDS is this deployment's account allow-list (one database per client).
# API version defaults to v26 (REST path /v26). v18–v22 are sunset and are not used.
# The adwords scope can write. This connector calls only search and searchStream.
# Later page-status and conversion-upload calls must use googleAdsGuard in lib/marketing/connectors/google-ads-client.ts.
# Rollback: set MARKETING_GOOGLE_ADS=off and restart. Stored rows stay. Google is not called.
MARKETING_GOOGLE_ADS=off
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_IDS=
GOOGLE_ADS_API_VERSION=v26
# Super admins seeded if missing. Comma-separated emails. Defaults: Jason, Brittany, Chris.
MARKETING_SUPER_ADMIN_EMAILS=
SEED_SUPER_ADMIN_PASSWORD=

# Workspace identity. Applied only on the first seed. Defaults are Specificity Inc / Avery.
# SEED_OFFICES format: Name|office|Timezone;Name|virtual
SEED_ORG_NAME=
SEED_ORG_SUBTITLE=
SEED_AGENT_NAME=
SEED_TIMEZONE=
SEED_OFFICES=
SEED_BRAND_COLOR=
SEED_LOGO_URL=
SEED_MARK=
SEED_KNOWLEDGE_TITLE=
SEED_KNOWLEDGE_PATH=
SEED_SAMPLE_DATA=
SHOW_DEMO_LOGIN=

# Operators created on the first seed. Defaults live in the README.
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_VIEWER_NAME=
SEED_VIEWER_EMAIL=
SEED_VIEWER_PASSWORD=
