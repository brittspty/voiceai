  platform      AudiencePlatformKind
  status        AudiencePushStatus   @default(pending)
  payload       Json
  manualSteps   String               @default("")
  logLine       String               @default("")
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  undoUntil     DateTime?
  createdAt     DateTime             @default(now())

  @@index([workspaceId, status])
  @@index([audienceId])
}

model AudiencePixelEvent {
  id          String       @id @default(cuid())
  workspaceId String
  audienceId  String
  audience    MaidAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  visitorId   String
  eventName   String
  pageUrl     String       @default("")
  occurredAt  DateTime     @default(now())

  @@index([workspaceId, audienceId])
  @@index([visitorId])
}

model AudienceConversion {
  id          String                   @id @default(cuid())
  workspaceId String
  audienceId  String
  audience    MaidAudience             @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  dedupeKey   String
  kind        String                   @default("lead")
  status      AudienceConversionStatus
  reason      String                   @default("")
  qualified   Boolean                  @default(false)
  contactHash String                   @default("")
  occurredAt  DateTime                 @default(now())

  @@unique([workspaceId, audienceId, dedupeKey])
  @@index([workspaceId, status])
  @@index([audienceId])
}

/// Prospect demo tenant. Rows here are fictional and never share a workspace id with a real client.
model DemoExhibit {
  id          String   @id
  workspaceId String
  kind        String
  payload     Json
  createdAt   DateTime @default(now())

  @@index([workspaceId, kind])
}

model DemoGrant {
  id        String    @id
  tokenHash String    @unique
  label     String    @default("")
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model DemoReseed {
  id         String   @id
  finishedAt DateTime
  status     String
}

enum ClientPlanStatus {
  draft
  preview
  approved
}

enum ClientPlanDashboard {
  demo
  baseline
}

model ClientPlan {
  id                  String              @id @default(cuid())
  slug                String
  clientName          String
  logoMime            String              @default("")
  logoData            Bytes?
  goals               String              @default("")
  channels            String[]            @default([])
  audiences           Json                @default("[]")
  segments            Json                @default("[]")
  dashboardSource     ClientPlanDashboard @default(demo)
  baselineWorkspaceId String              @default("")
  timeline            String              @default("")
  weekly              String              @default("")
  ctaLabel            String              @default("Let's start")
  ctaHref             String              @default("/contact")
  showCost            Boolean             @default(false)
  linkDays            Int                 @default(30)
  status              ClientPlanStatus    @default(draft)
  approvedById        String?
  approvedBy          User?               @relation("ClientPlanApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?
  tokenHash           String?             @unique
  expiresAt           DateTime?
  revokedAt           DateTime?
  createdById         String
  createdBy           User                @relation("ClientPlanCreator", fields: [createdById], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  views               ClientPlanView[]

  @@index([slug])
  @@index([status])
}

model PlatformRegistry {
  key             String             @id
  staffLabel      String
  clientLabel     String
  channelType     String
  vendor          String
  parentKey       String?
  auth            String
  scopesRead      Json
  writeCapable    Boolean            @default(false)
  writesEnabled   Boolean            @default(false)
  idUpload        Json
  matchRateSource String?
  metrics         Json
  hierarchy       String             @default("")
  colourToken     String             @default("#231F20")
  status          String             @default("available")
  aliases         Json               @default("[]")
  contracted      Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  connections     ClientConnection[]
}

model ClientConnection {
  id             String           @id @default(cuid())
  workspaceId    String           @default("org")
  clientId       String
  platformKey    String
  platform       PlatformRegistry @relation(fields: [platformKey], references: [key], onDelete: Cascade)
  accountId      String           @default("")
  state          String
  lastTestAt     DateTime?
  lastSyncAt     DateTime?
  tokenRef       String?
  writesEnabled  Boolean          @default(false)
  disconnectedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([workspaceId, clientId, platformKey])
  @@index([workspaceId, clientId])
}

/// Internal queue for platforms that are not listed. Nothing here is sent outside the app.
model PlatformRequest {
  id          String    @id @default(cuid())
  workspaceId String    @default("org")
  name        String
  category    String
  docsLink    String    @default("")
  clientId    String
  why         String
  status      String    @default("queued")
  decidedBy   String    @default("")
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, status])
}

model PlatformWriteApproval {
  id          String   @id @default(cuid())
  workspaceId String   @default("org")
  platformKey String
  approver    String
  note        String   @default("")
  createdAt   DateTime @default(now())

  @@index([workspaceId, platformKey])
}

/// Anonymous view log. Timestamp and a coarse browser class only.
model ClientPlanView {
  id              String     @id @default(cuid())
  planId          String
  plan            ClientPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  viewedAt        DateTime   @default(now())
  userAgentCoarse String

  @@index([planId, viewedAt])
}
