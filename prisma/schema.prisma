generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  viewer
  super_admin
  account_manager
  client_viewer
  all_clients_viewer
  demo_viewer
}

enum Consent {
  none
  low
  medium
  high
}

enum CallStatus {
  queued
  dialing
  in_progress
  wrap_up
  completed
  failed
}

enum CallOutcome {
  callback_requested
  booked
  not_interested
  no_answer
  voicemail
  failed
  wrong_number
}

enum CallDirection {
  outbound
  inbound
}

enum OfficeType {
  virtual
  office
}

enum OfficeStatus {
  active
  paused
}

enum VersionStatus {
  draft
  published
}

enum DocStatus {
  draft
  live
}

enum JobType {
  dial
  crm_writeback
  inbound_event
}

enum JobStatus {
  waiting
  running
  succeeded
  failed
  discarded
}

enum AppointmentFormat {
  phone
  video
  in_person
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
}

enum IntegrationStatus {
  healthy
  degraded
  down
  unconfigured
}

enum CrmUpdateStatus {
  pending
  succeeded
  failed
}

enum LeadLabel {
  qualified
  unqualified
  spam
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role
  totpSecret         String?
  totpPendingSecret  String?
  totpEnabled        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  sessions           Session[]
  budgetsSet         Campaign[]            @relation("BudgetSetBy")
  budgetAudits       CampaignBudgetAudit[]
  marketingScopes    MarketingAssignment[]
  clientAccess       ClientViewerAccess?
  shareLinksCreated  ClientShareLink[]
  clientViews        ClientViewAudit[]
  digests            ManagerDigest[]
  recommendationDecisions Recommendation[] @relation("RecommendationDecision")
  leadScoreOverrides     LeadScore[]       @relation("LeadScoreOverride")
  negativeDecisions  NegativeProposal[] @relation("NegativeDecision")
  competitorsCreated Competitor[]       @relation("CompetitorCreatedBy")
  competitorIdeas    CompetitorIdea[]   @relation("CompetitorIdeaCreatedBy")
  liftTestsCreated   LiftTest[]         @relation("LiftTestCreatedBy")
  liftTestsStarted   LiftTest[]         @relation("LiftTestStartedBy")
  leadValuesSet          ClientSettings[]     @relation("LeadValueSetBy")
  leadValueAudits        LeadValueAudit[]
  notifications          StaffNotification[]
  skillDecisions         SkillDecision[]
  inboxAssigned          InboxDecision[]      @relation("InboxAssigned")
  inboxDecided           InboxDecision[]      @relation("InboxDecided")
  clientPlansCreated     ClientPlan[]         @relation("ClientPlanCreator")
  clientPlansApproved    ClientPlan[]         @relation("ClientPlanApprover")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Org {
  id              String  @id @default("org")
  name            String
  subtitle        String
  agentName       String
  timezone        String
  brandColor      String  @default("#FF5800")
  logoUrl         String  @default("")
  mark            String  @default("S")
  testMode        Boolean @default(true)
  scheduleEnabled Boolean @default(false)
}

/// One row per client business. Voice is a paid add-on, off unless this client has it.
model Workspace {
  id           String   @id
  name         String
  voiceEnabled Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Office {
  id            String       @id @default(cuid())
  name          String
  timezone      String
  type          OfficeType
  status        OfficeStatus @default(active)
  calendarName  String
  ghlCalendarId String?
  syncedAt      DateTime?
  createdAt     DateTime     @default(now())
  advisors      Advisor[]
  hours         OfficeHour[]
  contacts      Contact[]
  calls         Call[]
  appointments  Appointment[]
}

model Advisor {
  id       String  @id @default(cuid())
  officeId String
  office   Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name     String
  email    String?
}

model OfficeHour {
  id        String  @id @default(cuid())
  officeId  String
  office    Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  weekday   Int
  closed    Boolean @default(false)
  openTime  String  @default("09:00")
  closeTime String  @default("17:00")

  @@unique([officeId, weekday])
}

model Contact {
  id           String        @id @default(cuid())
  name         String
  phone        String
  email        String?
  officeId     String?
  office       Office?       @relation(fields: [officeId], references: [id])
  consent      Consent       @default(none)
  consentAt    DateTime?
  source       String
  ghlContactId String?
  timezone     String        @default("America/New_York")
  fbclid       String        @default("")
  fbc          String        @default("")
  fbp          String        @default("")
  gclid        String        @default("")
  gbraid       String        @default("")
  wbraid       String        @default("")
  utmSource    String        @default("")
  utmMedium    String        @default("")
  utmCampaign  String        @default("")
  utmTerm      String        @default("")
  utmContent   String        @default("")
  createdAt    DateTime      @default(now())
  calls            Call[]
  appointments     Appointment[]
  leadResponses    LeadResponse[]
  leadScore        LeadScore?
  conversionEvents ConversionEvent[]

  @@index([phone])
  @@index([ghlContactId])
  @@index([gclid])
  @@index([fbclid])
}

model DoNotCall {
  id          String    @id @default(cuid())
  phone       String
  reason      String
  source      String
  addedById   String?
  addedByName String?
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone])
}

model Call {
  id                       String         @id @default(cuid())
  contactId                String
  contact                  Contact        @relation(fields: [contactId], references: [id])
  officeId                 String?
  office                   Office?        @relation(fields: [officeId], references: [id])
  status                   CallStatus
  outcome                  CallOutcome?
  direction                CallDirection  @default(outbound)
  startedAt                DateTime?
  endedAt                  DateTime?
  durationSec              Int            @default(0)
  costCents                Int            @default(0)
  consent                  Consent        @default(none)
  isTest                   Boolean        @default(false)
  transcript               Json           @default("[]")
  timeline                 Json           @default("[]")
  gateChecks               Json           @default("[]")
  recordingUrl             String?
  elevenLabsConversationId String?
  twilioCallSid            String?
  failureReason            String?
  gatesPassed              Boolean        @default(false)
  triggeredAt              DateTime       @default(now())
  dialedAt                 DateTime?
  connected                Boolean        @default(false)
  booked                   Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  appointments             Appointment[]
  leadScore                LeadScore?

  @@index([status])
  @@index([createdAt])
  @@index([contactId])
  @@index([elevenLabsConversationId])
  @@index([twilioCallSid])
}

model Appointment {
  id          String            @id @default(cuid())
  contactId   String
  contact     Contact           @relation(fields: [contactId], references: [id])
  officeId    String
  office      Office            @relation(fields: [officeId], references: [id])
  callId      String?
  call        Call?             @relation(fields: [callId], references: [id])
  advisorName String
  startsAt    DateTime
  endsAt      DateTime
  format      AppointmentFormat
  status      AppointmentStatus
  ghlEventId  String?
  createdAt   DateTime          @default(now())

  @@index([startsAt])
  @@index([officeId])
}

model KnowledgeDoc {
  id          String    @id @default(cuid())
  title       String
  body        String
  status      DocStatus @default(draft)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

model AgentVersion {
  id           String        @id @default(cuid())
  version      Int
  status       VersionStatus
  agentName    String
  instructions String
  openingLine  String
  authorId     String?
  authorName   String?
  createdAt    DateTime      @default(now())
  publishedAt  DateTime?
}

model VoiceVersion {
  id          String        @id @default(cuid())
  version     Int
  status      VersionStatus
  voiceId     String
  voiceName   String
  authorId    String?
  authorName  String?
  createdAt   DateTime      @default(now())
  publishedAt DateTime?
}

model CallingRulesVersion {
  id          String        @id @default(cuid())
  version     Int
  status      VersionStatus
  config      Json
  authorId    String?
  authorName  String?
  createdAt   DateTime      @default(now())
  publishedAt DateTime?
}

model Tag {
  id           String   @id @default(cuid())
  name         String   @unique
  contactCount Int      @default(0)
  source       String   @default("ghl")
  updatedAt    DateTime @updatedAt
}

model FieldMapping {
  id            String  @id @default(cuid())
  internalField String
  ghlField      String
  direction     String
  enabled       Boolean @default(true)
}

model CrmUpdate {
  id         String          @id @default(cuid())
  callId     String?
  contactId  String?
  summary    String
  payload    Json
  status     CrmUpdateStatus @default(pending)
  attempts   Int             @default(0)
  lastError  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Job {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(waiting)
  payload     Json
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  finishedAt  DateTime?
  callId      String?
  contactId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

model Activity {
  id          String   @id @default(cuid())
  actorId     String?
  actorName   String
  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model IntegrationCheck {
  provider  String            @id
  label     String
  detail    String
  status    IntegrationStatus
  latencyMs Int?
  checkedAt DateTime
}

// Marketing data layer.
// Tenant boundary is this database (one deployment per client), matching Org.
// workspaceId is stored so a later multi-tenant move does not rewrite the tables.
// It defaults to Org.id ("org") and is not an access-control key.

enum AdPlatform {
  meta
  google_ads
  tiktok
  linkedin
  stackadapt
  ais2l
}

enum MarketingAuthType {
  oauth
  system_user
  private_token
  internal
}

enum MarketingConnectionStatus {
  connected
  expired
  error
  disconnected
  unconfigured
}

enum MarketingEntityStatus {
  active
  paused
  archived
  deleted
  unknown
}

enum CampaignObjective {
  leads
  traffic
  conversions
  awareness
  calls
  other
}

enum BudgetType {
  daily
  lifetime
  none
}

enum CreativeFormat {
  image
  video
  carousel
  text
  lead_form
  unknown
}

enum AudienceType {
  custom_list
  lookalike
  interest
  keyword
  retargeting
  broad
  verified_human
  unknown
}

enum AudienceSegmentKind {
  targeting
  breakdown
}

enum AudienceLinkRole {
  include
  exclude
}

enum MarketingSyncKind {
  structure
  insights
  full
}

enum MarketingSyncStatus {
  running
  succeeded
  failed
  skipped
}

enum MarketingSyncMode {
  mock
  live
}

model PlatformConnection {
  id            String                    @id @default(cuid())
  workspaceId   String                    @default("org")
  platform      AdPlatform
  authType      MarketingAuthType
  secretRef     String
  appExternalId String                    @default("")
  status        MarketingConnectionStatus @default(unconfigured)
  lastSyncAt    DateTime?
  lastError     String?
  scopes        String[]                  @default([])
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  accounts      AdAccount[]
  syncRuns      MarketingSyncRun[]

  @@unique([workspaceId, platform])
  @@index([workspaceId])
}

model AdAccount {
  id           String                 @id @default(cuid())
  workspaceId  String                 @default("org")
  connectionId String
  connection   PlatformConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  platform     AdPlatform
  externalId   String
  name         String
  currency     String
  timezone     String
  status       MarketingEntityStatus  @default(unknown)
  syncEnabled  Boolean                @default(true)
  clientId     String?
  client       MarketingClient?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  campaigns    Campaign[]
  audiences    Audience[]
  assignments  MarketingAssignment[]
  alerts       AdAlert[]
  recommendations Recommendation[]
  negativeProposals NegativeProposal[]
  liftTests    LiftTest[]
  fatigueSignals  FatigueSignal[]
  pacingSnapshots PacingSnapshot[]
  adFatigueChecks AdFatigueCheck[]

  @@unique([workspaceId, platform, externalId])
  @@index([connectionId])
  @@index([clientId])
  @@index([workspaceId, platform, syncEnabled])
}

model Campaign {
  id           String                @id @default(cuid())
  workspaceId  String                @default("org")
  adAccountId  String
  adAccount    AdAccount             @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  platform     AdPlatform
  externalId   String
  name         String
  objective    CampaignObjective     @default(other)
  objectiveRaw String                @default("")
  status       MarketingEntityStatus @default(unknown)
  statusRaw    String                @default("")
  budgetType           BudgetType            @default(none)
  budgetAmount         Decimal?              @db.Decimal(18, 4)
  budgetCurrency       String                @default("USD")
  budgetSetById        String?
  budgetSetBy          User?                 @relation("BudgetSetBy", fields: [budgetSetById], references: [id], onDelete: SetNull)
  budgetSetAt          DateTime?
  reportedBudgetType   BudgetType            @default(none)
  reportedBudgetAmount Decimal?              @db.Decimal(18, 4)
  startDate    DateTime?
  endDate      DateTime?
  namingParsed Json                  @default("{}")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  adGroups        AdGroup[]
  metrics         DailyMetric[]
  searchTerms     SearchTermMetric[]
  budgetAudits    CampaignBudgetAudit[]
  alerts          AdAlert[]
  recommendations Recommendation[]
  negativeProposals NegativeProposal[]
  liftTests       LiftTest[]
  fatigueSignals  FatigueSignal[]
  pacingSnapshots PacingSnapshot[]
  adFatigueChecks AdFatigueCheck[]

  @@unique([workspaceId, platform, externalId])
  @@index([adAccountId])
  @@index([budgetSetById])
}

model AdGroup {
  id               String                @id @default(cuid())
  workspaceId      String                @default("org")
  campaignId       String
  campaign         Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform         AdPlatform
  externalId       String
  name             String
  status           MarketingEntityStatus @default(unknown)
  statusRaw        String                @default("")
  optimizationGoal String                @default("")
  bidStrategy      String                @default("")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  ads              Ad[]
  audiences        AdGroupAudience[]
  metrics          DailyMetric[]
  searchTerms      SearchTermMetric[]
  negativeProposals NegativeProposal[]

  @@unique([workspaceId, platform, externalId])
  @@index([campaignId])
}

model Creative {
  id          String            @id @default(cuid())
  workspaceId String            @default("org")
  name        String
  conceptKey  String
  conceptTag  String            @default("")
  format      CreativeFormat    @default(unknown)
  angle       String            @default("")
  offer       String            @default("")
  hook        String            @default("")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  versions    CreativeVersion[]

  @@unique([workspaceId, conceptKey])
  @@index([workspaceId])
}

model CreativeVersion {
  id                  String    @id @default(cuid())
  workspaceId         String    @default("org")
  creativeId          String
  creative            Creative  @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  versionLabel        String
  fingerprint         String
  status              CreativeVersionStatus @default(live)
  headline            String    @default("")
  body                String    @default("")
  description         String    @default("")
  cta                 String    @default("")
  mediaRef            String    @default("")
  landingUrl          String    @default("")
  firstSeenAt         DateTime  @default(now())
  platformCreativeIds Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  ads                 Ad[]
  metrics             DailyMetric[]
  fatigueSignals      FatigueSignal[]

  @@unique([workspaceId, fingerprint])
  @@index([creativeId])
}

model Ad {
  id                String                @id @default(cuid())
  workspaceId       String                @default("org")
  adGroupId         String
  adGroup           AdGroup               @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  platform          AdPlatform
  externalId        String
  name              String
  status            MarketingEntityStatus @default(unknown)
  statusRaw         String                @default("")
  creativeVersionId String?
  creativeVersion   CreativeVersion?      @relation(fields: [creativeVersionId], references: [id])
  destinationUrl    String                @default("")
  urlTags           String                @default("")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  metrics           DailyMetric[]
  hourly            AdHourlyMetric[]
  alerts            AdAlert[]
  recommendations   Recommendation[]
  systemPauses      SystemPausedAd[]
  fatigueSignals    FatigueSignal[]
  adFatigueChecks   AdFatigueCheck[]

  @@unique([workspaceId, platform, externalId])
  @@index([adGroupId])
  @@index([creativeVersionId])
}

model Audience {
  id                String            @id @default(cuid())
  workspaceId       String            @default("org")
  adAccountId       String?
  adAccount         AdAccount?        @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  platform          AdPlatform
  externalId        String
  name              String
  type              AudienceType      @default(unknown)
  sourceDescription String            @default("")
  sizeEstimate      Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  adGroups          AdGroupAudience[]

  @@unique([workspaceId, platform, externalId])
  @@index([adAccountId])
}

model AdGroupAudience {
  id          String           @id @default(cuid())
  workspaceId String           @default("org")
  adGroupId   String
  adGroup     AdGroup          @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  audienceId  String
  audience    Audience         @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  role        AudienceLinkRole

  @@unique([adGroupId, audienceId, role])
  @@index([audienceId])
}

model AudienceSegment {
  id          String              @id @default(cuid())
  workspaceId String              @default("org")
  segmentKey  String
  kind        AudienceSegmentKind
  label       String
  createdAt   DateTime            @default(now())
  metrics     DailyMetric[]

  @@unique([workspaceId, kind, segmentKey])
}

model MarketingSyncRun {
  id                 String              @id @default(cuid())
  workspaceId        String              @default("org")
  connectionId       String?
  connection         PlatformConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  platform           AdPlatform
  kind               MarketingSyncKind
  status             MarketingSyncStatus
  mode               MarketingSyncMode
  windowStart        DateTime?           @db.Date
  windowEnd          DateTime?           @db.Date
  requestedAccounts  String[]            @default([])
  rowsRead           Int                 @default(0)
  rowsWritten        Int                 @default(0)
  error              String?
  note               String              @default("")
  startedAt          DateTime            @default(now())
  finishedAt         DateTime?
  metrics            DailyMetric[]
  searchTerms        SearchTermMetric[]

  @@index([platform, startedAt])
  @@index([connectionId])
}

model DailyMetric {
  id                  String             @id @default(cuid())
  workspaceId         String             @default("org")
  date                DateTime           @db.Date
  platform            AdPlatform
  campaignId          String?
  campaign            Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adGroupId           String?
  adGroup             AdGroup?           @relation(fields: [adGroupId], references: [id], onDelete: SetNull)
  adId                String
  ad                  Ad                 @relation(fields: [adId], references: [id], onDelete: Cascade)
  creativeVersionId   String?
  creativeVersion     CreativeVersion?   @relation(fields: [creativeVersionId], references: [id], onDelete: SetNull)
  audienceSegmentId   String
  audienceSegment     AudienceSegment    @relation(fields: [audienceSegmentId], references: [id])
  attributionWindow   String
  currency            String             @default("USD")
  spend               Decimal            @default(0) @db.Decimal(18, 4)
  impressions         BigInt             @default(0)
  clicks              BigInt             @default(0)
  linkClicks          BigInt             @default(0)
  reach               BigInt             @default(0)
  platformLeads       Decimal            @default(0) @db.Decimal(18, 4)
  platformConversions Decimal            @default(0) @db.Decimal(18, 4)
  conversionValue     Decimal            @default(0) @db.Decimal(18, 4)
  videoViews3s        BigInt?
  thruplays           BigInt?
  ingestedAt          DateTime           @default(now())
  sourcePullId        String?
  sourcePull          MarketingSyncRun?  @relation(fields: [sourcePullId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, date, platform, adId, audienceSegmentId, attributionWindow])
  @@index([date])
  @@index([campaignId])
  @@index([sourcePullId])
}

/// Google Ads search terms. One row per term, ad group, match type, and day.
/// Spend is stored here and stripped for every role except super admin and account manager.
model SearchTermMetric {
  id                 String            @id @default(cuid())
  workspaceId        String            @default("org")
  platform           AdPlatform
  date               DateTime          @db.Date
  campaignExternalId String            @db.VarChar(64)
  adGroupExternalId  String            @db.VarChar(64)
  campaignId         String?
  campaign           Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adGroupId          String?
  adGroup            AdGroup?          @relation(fields: [adGroupId], references: [id], onDelete: SetNull)
  term               String            @db.VarChar(500)
  matchType          String            @default("") @db.VarChar(64)
  status             String            @default("") @db.VarChar(64)
  currency           String            @default("USD")
  spend              Decimal           @default(0) @db.Decimal(18, 4)
  impressions        BigInt            @default(0)
  clicks             BigInt            @default(0)
  conversions        Decimal           @default(0) @db.Decimal(18, 4)
  /// Set from an imported report. Null means the Google sync did not measure this separately, so waste detection uses conversions.
  qualifiedConversions Decimal?        @db.Decimal(18, 4)
  ingestedAt         DateTime          @default(now())
  sourcePullId       String?
  sourcePull         MarketingSyncRun? @relation(fields: [sourcePullId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, date, platform, campaignExternalId, adGroupExternalId, term, matchType], map: "SearchTermMetric_identity_key")
  @@index([date])
  @@index([campaignId])
  @@index([adGroupId])
  @@index([sourcePullId])
}

model Invite {
  id          String   @id @default(cuid())
  email       String
  name        String
  role        Role
  tokenHash   String   @unique
  expiresAt   DateTime
  createdById String
  createdAt   DateTime @default(now())

  @@index([email])
}

/// One-time sign-in link. The raw token is never stored. Nothing is emailed until Jason approves a sender.
model MagicLink {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model AccessRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  business  String
  createdAt DateTime @default(now())
}

// Homepage demo requests. Stored only. Nothing is emailed until a destination is chosen.
model HomepageContact {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String   @default("")
  message   String
  createdAt DateTime @default(now())
}

model MarketingRawRecord {
  id          String     @id @default(cuid())
  workspaceId String     @default("org")
  platform    AdPlatform
