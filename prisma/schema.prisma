  adAccount    AdAccount              @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId   String?
  campaign     Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adGroupId    String?
  adGroup      AdGroup?               @relation(fields: [adGroupId], references: [id], onDelete: SetNull)
  scopeKey     String                 @default("")
  campaignName String                 @default("")
  adGroupName  String                 @default("")
  term         String
  matchType    SearchMatchType
  level        NegativeLevel
  wasteSpend   Decimal                @default(0) @db.Decimal(18, 4)
  currency     String                 @default("USD")
  clicks       Int                    @default(0)
  impressions  Int                    @default(0)
