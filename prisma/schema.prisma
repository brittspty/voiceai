generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  viewer
  super_admin
  account_manager
  client_viewer
}

enum Consent {
  none
  low
  medium
  high
}

enum CallStatus {
  queued
  dialing
  in_progress
  wrap_up
  completed
  failed
}

enum CallOutcome {
  callback_requested
  booked
  not_interested
  no_answer
  voicemail
  failed
  wrong_number
}

enum CallDirection {
  outbound
  inbound
}

enum OfficeType {
  virtual
  office
}

enum OfficeStatus {
  active
  paused
}

enum VersionStatus {
  draft
  published
}

enum DocStatus {
  draft
  live
}

enum JobType {
  dial
  crm_writeback
  inbound_event
}

enum JobStatus {
  waiting
  running
  succeeded
  failed
  discarded
}

enum AppointmentFormat {
  phone
  video
  in_person
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
}

enum IntegrationStatus {
  healthy
  degraded
  down
  unconfigured
}

enum CrmUpdateStatus {
  pending
  succeeded
  failed
}

enum LeadLabel {
  qualified
  unqualified
  spam
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role
  totpSecret         String?
  totpPendingSecret  String?
  totpEnabled        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  sessions           Session[]
  budgetsSet         Campaign[]            @relation("BudgetSetBy")
  budgetAudits       CampaignBudgetAudit[]
  marketingScopes    MarketingAssignment[]
  clientAccess       ClientViewerAccess?
  shareLinksCreated  ClientShareLink[]
  clientViews        ClientViewAudit[]
  digests            ManagerDigest[]
  recommendationDecisions Recommendation[] @relation("RecommendationDecision")
  leadScoreOverrides     LeadScore[]       @relation("LeadScoreOverride")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Org {
  id              String  @id @default("org")
  name            String
  subtitle        String
  agentName       String
  timezone        String
  brandColor      String  @default("#FF5800")
  logoUrl         String  @default("")
  mark            String  @default("S")
  testMode        Boolean @default(true)
  scheduleEnabled Boolean @default(false)
}

model Office {
  id            String       @id @default(cuid())
  name          String
  timezone      String
  type          OfficeType
  status        OfficeStatus @default(active)
  calendarName  String
  ghlCalendarId String?
  syncedAt      DateTime?
  createdAt     DateTime     @default(now())
  advisors      Advisor[]
  hours         OfficeHour[]
  contacts      Contact[]
  calls         Call[]
  appointments  Appointment[]
}

model Advisor {
  id       String  @id @default(cuid())
  officeId String
  office   Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name     String
  email    String?
}

model OfficeHour {
  id        String  @id @default(cuid())
  officeId  String
  office    Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  weekday   Int
  closed    Boolean @default(false)
  openTime  String  @default("09:00")
  closeTime String  @default("17:00")

  @@unique([officeId, weekday])
}

model Contact {
  id           String        @id @default(cuid())
  name         String
  phone        String
  email        String?
  officeId     String?
  office       Office?       @relation(fields: [officeId], references: [id])
  consent      Consent       @default(none)
  consentAt    DateTime?
  source       String
  ghlContactId String?
  timezone     String        @default("America/New_York")
  fbclid       String        @default("")
  fbc          String        @default("")
  fbp          String        @default("")
  gclid        String        @default("")
  gbraid       String        @default("")
  wbraid       String        @default("")
  utmSource    String        @default("")
  utmMedium    String        @default("")
  utmCampaign  String        @default("")
  utmTerm      String        @default("")
  utmContent   String        @default("")
  createdAt    DateTime      @default(now())
  calls            Call[]
  appointments     Appointment[]
  leadResponses    LeadResponse[]
  leadScore        LeadScore?
  conversionEvents ConversionEvent[]

  @@index([phone])
  @@index([ghlContactId])
  @@index([gclid])
  @@index([fbclid])
}

model DoNotCall {
  id          String    @id @default(cuid())
  phone       String
  reason      String
  source      String
  addedById   String?
  addedByName String?
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone])
}

model Call {
  id                       String         @id @default(cuid())
  contactId                String
  contact                  Contact        @relation(fields: [contactId], references: [id])
  officeId                 String?
  office                   Office?        @relation(fields: [officeId], references: [id])
  status                   CallStatus
  outcome                  CallOutcome?
  direction                CallDirection  @default(outbound)
  startedAt                DateTime?
  endedAt                  DateTime?
  durationSec              Int            @default(0)
  costCents                Int            @default(0)
  consent                  Consent        @default(none)
  isTest                   Boolean        @default(false)
  transcript               Json           @default("[]")
  timeline                 Json           @default("[]")
  gateChecks               Json           @default("[]")
  recordingUrl             String?
  elevenLabsConversationId String?
  twilioCallSid            String?
  failureReason            String?
  gatesPassed              Boolean        @default(false)
  triggeredAt              DateTime       @default(now())
  dialedAt                 DateTime?
  connected                Boolean        @default(false)
  booked                   Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  appointments             Appointment[]
  leadScore                LeadScore?

  @@index([status])
  @@index([createdAt])
  @@index([contactId])
  @@index([elevenLabsConversationId])
  @@index([twilioCallSid])
}

model Appointment {
  id          String            @id @default(cuid())
  contactId   String
  contact     Contact           @relation(fields: [contactId], references: [id])
  officeId    String
  office      Office            @relation(fields: [officeId], references: [id])
  callId      String?
  call        Call?             @relation(fields: [callId], references: [id])
  advisorName String
  startsAt    DateTime
  endsAt      DateTime
  format      AppointmentFormat
  status      AppointmentStatus
  ghlEventId  String?
  createdAt   DateTime          @default(now())

  @@index([startsAt])
  @@index([officeId])
}

model KnowledgeDoc {
  id          String    @id @default(cuid())
  title       String
  body        String
  status      DocStatus @default(draft)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
}

model AgentVersion {
  id           String        @id @default(cuid())
  version      Int
  status       VersionStatus
  agentName    String
  instructions String
  openingLine  String
  authorId     String?
  authorName   String?
  createdAt    DateTime      @default(now())
  publishedAt  DateTime?
}

model VoiceVersion {
  id          String        @id @default(cuid())
  version     Int
  status      VersionStatus
  voiceId     String
  voiceName   String
  authorId    String?
  authorName  String?
  createdAt   DateTime      @default(now())
  publishedAt DateTime?
}

model CallingRulesVersion {
  id          String        @id @default(cuid())
  version     Int
  status      VersionStatus
  config      Json
  authorId    String?
  authorName  String?
  createdAt   DateTime      @default(now())
  publishedAt DateTime?
}

model Tag {
  id           String   @id @default(cuid())
  name         String   @unique
  contactCount Int      @default(0)
  source       String   @default("ghl")
  updatedAt    DateTime @updatedAt
}

model FieldMapping {
  id            String  @id @default(cuid())
  internalField String
  ghlField      String
  direction     String
  enabled       Boolean @default(true)
}

model CrmUpdate {
  id         String          @id @default(cuid())
  callId     String?
  contactId  String?
  summary    String
  payload    Json
  status     CrmUpdateStatus @default(pending)
  attempts   Int             @default(0)
  lastError  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Job {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(waiting)
  payload     Json
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  finishedAt  DateTime?
  callId      String?
  contactId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

model Activity {
  id          String   @id @default(cuid())
  actorId     String?
  actorName   String
  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model IntegrationCheck {
  provider  String            @id
  label     String
  detail    String
  status    IntegrationStatus
  latencyMs Int?
  checkedAt DateTime
}

// Marketing data layer.
// Tenant boundary is this database (one deployment per client), matching Org.
// workspaceId is stored so a later multi-tenant move does not rewrite the tables.
// It defaults to Org.id ("org") and is not an access-control key.

enum AdPlatform {
  meta
  google_ads
  tiktok
  linkedin
}

enum MarketingAuthType {
  oauth
  system_user
  private_token
  internal
}

enum MarketingConnectionStatus {
  connected
  expired
  error
  disconnected
  unconfigured
}

enum MarketingEntityStatus {
  active
  paused
  archived
  deleted
  unknown
}

enum CampaignObjective {
  leads
  traffic
  conversions
  awareness
  calls
  other
}

enum BudgetType {
  daily
  lifetime
  none
}

enum CreativeFormat {
  image
  video
  carousel
  text
  lead_form
  unknown
}

enum AudienceType {
  custom_list
  lookalike
  interest
  keyword
  retargeting
  broad
  verified_human
  unknown
}

enum AudienceSegmentKind {
  targeting
  breakdown
}

enum AudienceLinkRole {
  include
  exclude
}

enum MarketingSyncKind {
  structure
  insights
  full
}

enum MarketingSyncStatus {
  running
  succeeded
  failed
  skipped
}

enum MarketingSyncMode {
  mock
  live
}

model PlatformConnection {
  id            String                    @id @default(cuid())
  workspaceId   String                    @default("org")
  platform      AdPlatform
  authType      MarketingAuthType
  secretRef     String
  appExternalId String                    @default("")
  status        MarketingConnectionStatus @default(unconfigured)
  lastSyncAt    DateTime?
  lastError     String?
  scopes        String[]                  @default([])
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  accounts      AdAccount[]
  syncRuns      MarketingSyncRun[]

  @@unique([workspaceId, platform])
  @@index([workspaceId])
}

model AdAccount {
  id           String                 @id @default(cuid())
  workspaceId  String                 @default("org")
  connectionId String
  connection   PlatformConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  platform     AdPlatform
  externalId   String
  name         String
  currency     String
  timezone     String
  status       MarketingEntityStatus  @default(unknown)
  syncEnabled  Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  campaigns    Campaign[]
  audiences    Audience[]
  assignments  MarketingAssignment[]
  alerts       AdAlert[]
  recommendations Recommendation[]

  @@unique([workspaceId, platform, externalId])
  @@index([connectionId])
  @@index([workspaceId, platform, syncEnabled])
}

model Campaign {
  id           String                @id @default(cuid())
  workspaceId  String                @default("org")
  adAccountId  String
  adAccount    AdAccount             @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  platform     AdPlatform
  externalId   String
  name         String
  objective    CampaignObjective     @default(other)
  objectiveRaw String                @default("")
  status       MarketingEntityStatus @default(unknown)
  statusRaw    String                @default("")
  budgetType           BudgetType            @default(none)
  budgetAmount         Decimal?              @db.Decimal(18, 4)
  budgetCurrency       String                @default("USD")
  budgetSetById        String?
  budgetSetBy          User?                 @relation("BudgetSetBy", fields: [budgetSetById], references: [id], onDelete: SetNull)
  budgetSetAt          DateTime?
  reportedBudgetType   BudgetType            @default(none)
  reportedBudgetAmount Decimal?              @db.Decimal(18, 4)
  startDate    DateTime?
  endDate      DateTime?
  namingParsed Json                  @default("{}")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  adGroups        AdGroup[]
  metrics         DailyMetric[]
  searchTerms     SearchTermMetric[]
  budgetAudits    CampaignBudgetAudit[]
  alerts          AdAlert[]
  recommendations Recommendation[]

  @@unique([workspaceId, platform, externalId])
  @@index([adAccountId])
  @@index([budgetSetById])
}

model AdGroup {
  id               String                @id @default(cuid())
  workspaceId      String                @default("org")
  campaignId       String
  campaign         Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform         AdPlatform
  externalId       String
  name             String
  status           MarketingEntityStatus @default(unknown)
  statusRaw        String                @default("")
  optimizationGoal String                @default("")
  bidStrategy      String                @default("")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  ads              Ad[]
  audiences        AdGroupAudience[]
  metrics          DailyMetric[]
  searchTerms      SearchTermMetric[]

  @@unique([workspaceId, platform, externalId])
  @@index([campaignId])
}

model Creative {
  id          String            @id @default(cuid())
  workspaceId String            @default("org")
  name        String
  conceptKey  String
  conceptTag  String            @default("")
  format      CreativeFormat    @default(unknown)
  angle       String            @default("")
  offer       String            @default("")
  hook        String            @default("")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  versions    CreativeVersion[]

  @@unique([workspaceId, conceptKey])
  @@index([workspaceId])
}

model CreativeVersion {
  id                  String    @id @default(cuid())
  workspaceId         String    @default("org")
  creativeId          String
  creative            Creative  @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  versionLabel        String
  fingerprint         String
  headline            String    @default("")
  body                String    @default("")
  description         String    @default("")
  cta                 String    @default("")
  mediaRef            String    @default("")
  landingUrl          String    @default("")
  firstSeenAt         DateTime  @default(now())
  platformCreativeIds Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  ads                 Ad[]
  metrics             DailyMetric[]

  @@unique([workspaceId, fingerprint])
  @@index([creativeId])
}

model Ad {
  id                String                @id @default(cuid())
  workspaceId       String                @default("org")
  adGroupId         String
  adGroup           AdGroup               @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  platform          AdPlatform
  externalId        String
  name              String
  status            MarketingEntityStatus @default(unknown)
  statusRaw         String                @default("")
  creativeVersionId String?
  creativeVersion   CreativeVersion?      @relation(fields: [creativeVersionId], references: [id])
  destinationUrl    String                @default("")
  urlTags           String                @default("")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  metrics           DailyMetric[]
  hourly            AdHourlyMetric[]
  alerts            AdAlert[]
  recommendations   Recommendation[]

  @@unique([workspaceId, platform, externalId])
  @@index([adGroupId])
  @@index([creativeVersionId])
}

model Audience {
  id                String            @id @default(cuid())
  workspaceId       String            @default("org")
  adAccountId       String?
  adAccount         AdAccount?        @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  platform          AdPlatform
  externalId        String
  name              String
  type              AudienceType      @default(unknown)
  sourceDescription String            @default("")
  sizeEstimate      Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  adGroups          AdGroupAudience[]

  @@unique([workspaceId, platform, externalId])
  @@index([adAccountId])
}

model AdGroupAudience {
  id          String           @id @default(cuid())
  workspaceId String           @default("org")
  adGroupId   String
  adGroup     AdGroup          @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  audienceId  String
  audience    Audience         @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  role        AudienceLinkRole

  @@unique([adGroupId, audienceId, role])
  @@index([audienceId])
}

model AudienceSegment {
  id          String              @id @default(cuid())
  workspaceId String              @default("org")
  segmentKey  String
  kind        AudienceSegmentKind
  label       String
  createdAt   DateTime            @default(now())
  metrics     DailyMetric[]

  @@unique([workspaceId, kind, segmentKey])
}

model MarketingSyncRun {
  id                 String              @id @default(cuid())
  workspaceId        String              @default("org")
  connectionId       String?
  connection         PlatformConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  platform           AdPlatform
  kind               MarketingSyncKind
  status             MarketingSyncStatus
  mode               MarketingSyncMode
  windowStart        DateTime?           @db.Date
  windowEnd          DateTime?           @db.Date
  requestedAccounts  String[]            @default([])
  rowsRead           Int                 @default(0)
  rowsWritten        Int                 @default(0)
  error              String?
  note               String              @default("")
  startedAt          DateTime            @default(now())
  finishedAt         DateTime?
  metrics            DailyMetric[]
  searchTerms        SearchTermMetric[]

  @@index([platform, startedAt])
  @@index([connectionId])
}

model DailyMetric {
  id                  String             @id @default(cuid())
  workspaceId         String             @default("org")
  date                DateTime           @db.Date
  platform            AdPlatform
  campaignId          String?
  campaign            Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adGroupId           String?
  adGroup             AdGroup?           @relation(fields: [adGroupId], references: [id], onDelete: SetNull)
  adId                String
  ad                  Ad                 @relation(fields: [adId], references: [id], onDelete: Cascade)
  creativeVersionId   String?
  creativeVersion     CreativeVersion?   @relation(fields: [creativeVersionId], references: [id], onDelete: SetNull)
  audienceSegmentId   String
  audienceSegment     AudienceSegment    @relation(fields: [audienceSegmentId], references: [id])
  attributionWindow   String
  currency            String             @default("USD")
  spend               Decimal            @default(0) @db.Decimal(18, 4)
  impressions         BigInt             @default(0)
  clicks              BigInt             @default(0)
  linkClicks          BigInt             @default(0)
  reach               BigInt             @default(0)
  platformLeads       Decimal            @default(0) @db.Decimal(18, 4)
  platformConversions Decimal            @default(0) @db.Decimal(18, 4)
  conversionValue     Decimal            @default(0) @db.Decimal(18, 4)
  videoViews3s        BigInt?
  thruplays           BigInt?
  ingestedAt          DateTime           @default(now())
  sourcePullId        String?
  sourcePull          MarketingSyncRun?  @relation(fields: [sourcePullId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, date, platform, adId, audienceSegmentId, attributionWindow])
  @@index([date])
  @@index([campaignId])
  @@index([sourcePullId])
}

/// Google Ads search terms. One row per term, ad group, match type, and day.
/// Spend is stored here and stripped for every role except super admin and account manager.
model SearchTermMetric {
  id                 String            @id @default(cuid())
  workspaceId        String            @default("org")
  platform           AdPlatform
  date               DateTime          @db.Date
  campaignExternalId String            @db.VarChar(64)
  adGroupExternalId  String            @db.VarChar(64)
  campaignId         String?
  campaign           Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adGroupId          String?
  adGroup            AdGroup?          @relation(fields: [adGroupId], references: [id], onDelete: SetNull)
  term               String            @db.VarChar(500)
  matchType          String            @default("") @db.VarChar(64)
  status             String            @default("") @db.VarChar(64)
  currency           String            @default("USD")
  spend              Decimal           @default(0) @db.Decimal(18, 4)
  impressions        BigInt            @default(0)
  clicks             BigInt            @default(0)
  conversions        Decimal           @default(0) @db.Decimal(18, 4)
  ingestedAt         DateTime          @default(now())
  sourcePullId       String?
  sourcePull         MarketingSyncRun? @relation(fields: [sourcePullId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, date, platform, campaignExternalId, adGroupExternalId, term, matchType], map: "SearchTermMetric_identity_key")
  @@index([date])
  @@index([campaignId])
  @@index([adGroupId])
  @@index([sourcePullId])
}

model Invite {
  id          String   @id @default(cuid())
  email       String
  name        String
  role        Role
  tokenHash   String   @unique
  expiresAt   DateTime
  createdById String
  createdAt   DateTime @default(now())

  @@index([email])
}

model AccessRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  business  String
  createdAt DateTime @default(now())
}

model MarketingRawRecord {
  id          String     @id @default(cuid())
  workspaceId String     @default("org")
  platform    AdPlatform
  objectType  String
  externalId  String
  payload     Json
  fetchedAt   DateTime   @default(now())
  syncRunId   String?

  @@unique([workspaceId, platform, objectType, externalId])
  @@index([syncRunId])
}

enum AlertSeverity {
  info
  warning
  critical
}

enum RecommendationStatus {
  draft
  verified
  dismissed
  accepted
  declined
}

enum RecommendationType {
  performance
  traffic
  roi
  budget_change
  speed_to_lead
}

enum MarketingScopeKind {
  client
  ad_account
  campaign
}

model CampaignBudgetAudit {
  id               String     @id @default(cuid())
  campaignId       String
  campaign         Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  amount           Decimal    @db.Decimal(18, 4)
  period           BudgetType
  currency         String
  setById          String
  setBy            User       @relation(fields: [setById], references: [id])
  setAt            DateTime
  source           String
  recommendationId String?
  note             String     @default("")

  @@index([campaignId, setAt])
}

model MarketingAssignment {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String             @default("org")
  scopeKind   MarketingScopeKind
  adAccountId String?
  adAccount   AdAccount?         @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId  String?
  createdAt   DateTime           @default(now())

  @@index([userId])
  @@index([adAccountId])
  @@index([campaignId])
}

model ClientViewerAccess {
  userId      String @id
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  createdAt   DateTime @default(now())
}

model ClientShareLink {
  id          String    @id @default(cuid())
  workspaceId String
  tokenHash   String    @unique
  label        String   @default("")
  passcodeHash String?
  createdById  String
  createdBy   User      @relation(fields: [createdById], references: [id])
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  views       ClientViewAudit[]

  @@index([workspaceId])
}

model ClientViewAudit {
  id           String          @id @default(cuid())
  workspaceId  String
  viewerUserId String?
  viewer       User?           @relation(fields: [viewerUserId], references: [id], onDelete: SetNull)
  shareLinkId  String?
  shareLink    ClientShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  page         String
  ip           String
  userAgent    String
  viewedAt     DateTime        @default(now())

  @@index([workspaceId, viewedAt])
  @@index([shareLinkId])
}

model AdAlert {
  id            String        @id @default(cuid())
  workspaceId   String        @default("org")
  adId          String
  ad            Ad            @relation(fields: [adId], references: [id], onDelete: Cascade)
  adAccountId   String
  adAccount     AdAccount     @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId    String
  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  severity      AlertSeverity
  code          String
  title         String
  summary       String
  metric        String
  observed      String
  baseline      String
  windowStart   DateTime?     @db.Date
  windowEnd     DateTime?     @db.Date
  sampleSize    Int
  evidence      Json
  sourceMetricIds String[]    @default([])
  syncRunId     String?
  dataLandedAt  DateTime
  detectedAt    DateTime
  createdAt     DateTime      @default(now())

  @@index([adAccountId, createdAt])
  @@index([campaignId])
  @@index([detectedAt])
}

model Recommendation {
  id                    String               @id @default(cuid())
  workspaceId           String               @default("org")
  type                  RecommendationType
  status                RecommendationStatus @default(draft)
  adId                  String?
  ad                    Ad?                  @relation(fields: [adId], references: [id], onDelete: SetNull)
  campaignId            String?
  campaign              Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adAccountId           String?
  adAccount             AdAccount?           @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  title                 String
  summary               String
  rationale             String
  metric                String
  baseline              String
  observed              String
  windowStart           DateTime?            @db.Date
  windowEnd             DateTime?            @db.Date
  sampleSize            Int
  sourceMetricIds       String[]             @default([])
  evidence              Json
  currentBudgetAmount   Decimal?             @db.Decimal(18, 4)
  currentBudgetPeriod   BudgetType?
  proposedBudgetAmount  Decimal?             @db.Decimal(18, 4)
  proposedBudgetPeriod  BudgetType?
  proposedCurrency      String?
  verifiedAt            DateTime?
  verifierNote          String               @default("")
  decidedById           String?
  decidedBy             User?                @relation("RecommendationDecision", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt             DateTime?
  decisionNote          String               @default("")
  createdAt             DateTime             @default(now())

  @@index([status, createdAt])
  @@index([adAccountId])
  @@index([campaignId])
}

model ManagerDigest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  payload     Json
  delivery    String   @default("not_sent")
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

enum ConversionStageKind {
  qualified
  booked
  sold
}

enum ConversionPlatform {
  meta
  google_ads
}

enum ConversionUploadStatus {
  dry_run
  sent
  failed
  skipped
}

enum ConversionDecisionStatus {
  pending
  accepted
  declined
  later
}

/// One GoHighLevel location whose booked and sold stages can be sent back to ads.
/// enabledAt is set only after the yes card is approved and the undo window closes.
model ConversionClient {
  id            String    @id @default(cuid())
  workspaceId   String    @default("org")
  name              String
  ghlLocationId     String    @default("")
  /// This client's Meta dataset. Empty means Meta uploads are refused.
  metaDatasetId     String    @default("")
  /// This client's 10-digit Google Ads customer id. Empty means Google uploads are refused.
  googleCustomerId  String    @default("")
  enabledAt         DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  stages        ConversionStageMap[]
  events        ConversionEvent[]
  decisions     ConversionDecision[]
  issues        ConversionIssue[]
  alerts        ConversionAlert[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([ghlLocationId])
}

model ConversionStageMap {
  id            String              @id @default(cuid())
  clientId      String
  client        ConversionClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ghlStageId    String              @default("")
  ghlStageName  String
  kind          ConversionStageKind
  valueCents    Int?
  currency      String              @default("USD")
  metaEventName String
  googleAction  String              @default("")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([clientId, ghlStageId, ghlStageName])
  @@index([clientId])
}

model ConversionEvent {
  id              String              @id @default(cuid())
  clientId        String
  client          ConversionClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source          String
  externalId      String
  kind            ConversionStageKind
  stageName       String
  valueCents      Int?
  currency        String              @default("USD")
  fbclid          String              @default("")
  fbc             String              @default("")
  fbp             String              @default("")
  gclid           String              @default("")
  gbraid          String              @default("")
  wbraid          String              @default("")
  utmSource       String              @default("")
  utmMedium       String              @default("")
  utmCampaign     String              @default("")
  utmTerm         String              @default("")
  utmContent      String              @default("")
  emailHashMeta   String              @default("")
  emailHashGoogle String              @default("")
  phoneHashMeta   String              @default("")
  phoneHashGoogle String              @default("")
  occurredAt      DateTime
  createdAt       DateTime            @default(now())
  uploads         ConversionUpload[]

  @@unique([clientId, externalId, kind])
  @@index([clientId, occurredAt])
  @@index([contactId])
}

model ConversionUpload {
  id           String                 @id @default(cuid())
  eventId      String
  event        ConversionEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  platform     ConversionPlatform
  status       ConversionUploadStatus
  payload      Json
  response     Json?
  attempts     Int                    @default(0)
  errorCode    String                 @default("")
  errorMessage String                 @default("")
  createdAt    DateTime               @default(now())
  sentAt       DateTime?

  @@unique([eventId, platform])
  @@index([platform, status, createdAt])
}

model ConversionDecision {
  id          String                   @id @default(cuid())
  clientId    String
  client      ConversionClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status      ConversionDecisionStatus @default(pending)
  expiresAt   DateTime
  decidedById String?
  decidedAt   DateTime?
  undoUntil   DateTime?
  createdAt   DateTime                 @default(now())

  @@index([clientId, createdAt])
}

/// Count-only problems. No contact details and no payloads.
model ConversionIssue {
  id         String           @id @default(cuid())
  clientId   String
  client     ConversionClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code       String
  platform   String           @default("")
  occurredAt DateTime
  createdAt  DateTime         @default(now())

  @@index([clientId, occurredAt])
}

model ConversionAlert {
  id         String           @id @default(cuid())
  clientId   String
  client     ConversionClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform   ConversionPlatform
  severity   AlertSeverity
  code       String
  dedupeKey  String
  title      String
  summary    String
  firedAt    DateTime
  resolvedAt DateTime?
  mutedUntil DateTime?
  createdAt  DateTime         @default(now())

  @@index([dedupeKey, firedAt])
  @@index([clientId])
}

model AdHourlyMetric {
  id           String   @id @default(cuid())
  workspaceId  String   @default("org")
  adId         String
  ad           Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  hour         Int
  impressions  BigInt   @default(0)
  clicks       BigInt   @default(0)
  conversions  Decimal  @default(0) @db.Decimal(18, 4)

  @@unique([adId, date, hour])
  @@index([date])
}

enum LeadClockSource {
  landing
  form_submit
  call_start
  webhook_arrival
}

enum LeadTouchChannel {
  human
  voice_ai
  sms
}

enum LeadAlertState {
  open
  resolved
  muted
}

/// Per-client response target. Missing row means the 30 second default.
model ClientSla {
  id              String   @id @default(cuid())
  workspaceId     String   @unique @default("org")
  targetSeconds   Int      @default(30)
  criticalSeconds Int      @default(900)
  openTime        String   @default("08:00")
  closeTime       String   @default("21:00")
  timezone        String   @default("America/New_York")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Page-landing timestamp, matched to a later form by session key, phone, or email.
model LeadLanding {
  id          String   @id @default(cuid())
  workspaceId String   @default("org")
  sessionKey  String
  landedAt    DateTime
  createdAt   DateTime @default(now())

  @@index([workspaceId, sessionKey, landedAt])
}

model LeadResponse {
  id               String            @id @default(cuid())
  workspaceId      String            @default("org")
  contactId        String?
  contact          Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  callId           String?
  name             String
  phone            String            @default("")
  email            String            @default("")
  sessionKey       String            @default("")
  leadSource       String            @default("Form")
  landedAt         DateTime?
  submittedAt      DateTime?
  callStartedAt    DateTime?
  clockStartAt     DateTime
  clockSource      LeadClockSource
  slaStartAt       DateTime
  afterHours       Boolean           @default(false)
  firstTouchAt     DateTime?
  channel          LeadTouchChannel?
  seconds          Int?
  touchedById      String?
  mutedUntil       DateTime?
  recommendationId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  alerts           LeadAlert[]

  @@index([workspaceId, slaStartAt])
  @@index([workspaceId, firstTouchAt])
  @@index([contactId])
  @@index([sessionKey])
}

model LeadAlert {
  id             String         @id @default(cuid())
  workspaceId    String         @default("org")
  leadResponseId String
  leadResponse   LeadResponse   @relation(fields: [leadResponseId], references: [id], onDelete: Cascade)
  severity       AlertSeverity
  code           String
  title          String
  summary        String
  dedupeKey      String
  state          LeadAlertState @default(open)
  detectedAt     DateTime
  resolvedAt     DateTime?
  resolveNote    String         @default("")
  createdAt      DateTime       @default(now())

  @@unique([dedupeKey, severity])
  @@index([workspaceId, detectedAt])
  @@index([state])
}

/// In-app record of a push slot. This build does not send SMS or push.
model SpeedNotify {
  id          String        @id @default(cuid())
  workspaceId String        @default("org")
  userId      String
  pushedAt    DateTime
  severity    AlertSeverity

  @@index([workspaceId, userId, pushedAt])
}

// One row per form lead (contactId) or call transcript (callId).
// Machine label, score, reason, and model stay put when a person overrides them.
model LeadScore {
  id              String     @id @default(cuid())
  workspaceId     String     @default("org")
  contactId       String?    @unique
  contact         Contact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  callId          String?    @unique
  call            Call?      @relation(fields: [callId], references: [id], onDelete: Cascade)
  label           LeadLabel
  score           Int
  reason          String
  model           String     @default("rules")
  evidence        Json       @default("{}")
  overrideLabel   LeadLabel?
  overrideReason  String     @default("")
  overriddenById  String?
  overriddenBy    User?      @relation("LeadScoreOverride", fields: [overriddenById], references: [id], onDelete: SetNull)
  overriddenAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([workspaceId, createdAt])
  @@index([overriddenById])
}
