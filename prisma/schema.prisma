  reason              String
  metric              String          @default("")
  clickDays           Decimal         @db.Decimal(8, 4)
  viewDays            Decimal         @db.Decimal(8, 4)
  goodChecks          Decimal         @db.Decimal(8, 4)
  threshold           Decimal         @db.Decimal(6, 4)
