enum AudienceSourceKind {
  data_market_maid
  pixel_retargeting
  crm_first_party
  platform_native
}

enum AudiencePlatformKind {
  meta
  google_customer_match
  tiktok
  stackadapt
  generic_dsp
}

enum MaidIdentifierType {
  idfa
  gaid
  email_sha256
  phone_sha256
}

enum AudienceRefreshCadence {
  daily
  weekly
  monthly
  quarterly
}

enum SegmentDimensionKind {
  intent
  geo
  demographics
  behavior
}

enum AudiencePushStatus {
  pending
  approved
  declined
}

enum AudienceConversionStatus {
  verified
  unverified
}

model MaidAudience {
  id              String                 @id @default(cuid())
  workspaceId     String
  name            String
  source          AudienceSourceKind     @default(data_market_maid)
  vendor          String
  listId          String
  acquisitionDate DateTime?              @db.Date
  costAmount      Decimal?               @db.Decimal(18, 4)
  costCurrency    String                 @default("USD")
  consentBasis    String
  /// IAB Tech Lab Data Label. Optional. Kept for a later consent proof.
  dataLabel       String                 @default("")
  /// GPP string. Optional. Kept for a later consent proof.
  gppString       String                 @default("")
  /// Where consent was collected: first_party or upstream_supplier. Empty until recorded.
  consentOrigin   String                 @default("")
