enum InboxDecisionKind {
  budget_recommendation
  pacing_recommendation
  fatigue_pause
  fatigue_rotation
  creative_approval
  lead_check
  page_alert
  negative_keyword
  holdout
  learning
}

enum InboxDecisionStatus {
  waiting
  accepted
  declined
  later
  done
}

enum ServeRecommendation {
  serve
  pause
  rotate
}

/// Yes/no cards. Fatigue pauses and rotations are never automatic.
/// automatic is constrained false. Budget cards store steps, not a write.

model InboxDecision {
  id                String               @id @default(cuid())
  workspaceId       String               @default("org")
  clientKey         String               @default("")
  clientName        String               @default("")
  campaignId        String?
  adAccountId       String?
  assigneeId        String?
  assignee          User?                @relation("InboxAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)
  kind              InboxDecisionKind
  status            InboxDecisionStatus  @default(waiting)
  tier              String               @default("staff")
  title             String
  reasoning         String
  confidence        Int                  @default(0)
  expiresAt         DateTime?
  evidence          Json                 @default("[]")
  steps             Json                 @default("[]")
  serve             ServeRecommendation?
  creditWindowLabel String               @default("")
  automatic         Boolean              @default(false)
  decidedById       String?
  decidedBy         User?                @relation("InboxDecided", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt         DateTime?
  decisionNote      String               @default("")
  createdAt         DateTime             @default(now())

  @@index([workspaceId, status, createdAt])
  @@index([assigneeId, status])
  @@index([campaignId])
  @@index([decidedById])
}

// Audience library. Source is the top of the segment taxonomy.
